#ifndef BUCKWILD_BUILD_INFO_H
#define BUCKWILD_BUILD_INFO_H

#define BUCKWILD_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define BUCKWILD_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define BUCKWILD_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define BUCKWILD_VERSION "@PROJECT_VERSION@"

#define BUCKWILD_BUILD_TYPE "@CMAKE_BUILD_TYPE@"
#define BUCKWILD_COMPILER "@CMAKE_C_COMPILER_ID@"
#define BUCKWILD_COMPILER_VERSION "@CMAKE_C_COMPILER_VERSION@"

#cmakedefine HAVE_AVX2
#cmakedefine HAVE_AVX512
#cmakedefine ENABLE_SECURITY_HARDENING

#endif /* BUCKWILD_BUILD_INFO_H */