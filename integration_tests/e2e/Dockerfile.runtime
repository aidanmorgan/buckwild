# Runtime-only Dockerfile for E2E testing
# Uses pre-built binaries from devcontainer build

FROM debian:bookworm-slim

# Install runtime dependencies and networking tools
RUN apt-get update && apt-get install -y \
    iproute2 \
    iptables \
    netcat-openbsd \
    tcpdump \
    iperf3 \
    curl \
    libssl3 \
    jq \
    bc \
    coreutils \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built buckwild-daemon binary
COPY buckwild-daemon /usr/local/bin/buckwild-daemon
RUN chmod +x /usr/local/bin/buckwild-daemon

# Copy pre-built libnetssd.so library
COPY libbuckwild_netssd.so /usr/local/lib/libnetssd.so
RUN ldconfig

# Create PSK directory with owner-only permissions
RUN mkdir -p /etc/buckwild/psk && chmod 700 /etc/buckwild/psk

# Expose daemon port
EXPOSE 8080

# Default command
CMD ["buckwild-daemon"]
