# Test Dockerfile for integration testing
FROM rust:1.70 as builder

WORKDIR /app
COPY . .

# Build the daemon
RUN cargo build --release --bin buckwild-daemon

# Runtime image
FROM ubuntu:22.04

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    iproute2 \
    iptables \
    netcat \
    tcpdump \
    iperf3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy the built binary
COPY --from=builder /app/target/release/buckwild-daemon /usr/local/bin/

# Create directories
RUN mkdir -p /etc/buckwild/psk

# Create test PSK files (in real deployment, these would be securely generated)
RUN echo "test-psk-peer-a" > /etc/buckwild/psk/peer-a.key && \
    echo "test-psk-peer-b" > /etc/buckwild/psk/peer-b.key && \
    echo "test-psk-peer-c" > /etc/buckwild/psk/peer-c.key

# Set permissions
RUN chmod 600 /etc/buckwild/psk/*.key

# Expose port
EXPOSE 8080

# Default command
CMD ["buckwild-daemon", "--config", "/etc/buckwild/config.toml"]