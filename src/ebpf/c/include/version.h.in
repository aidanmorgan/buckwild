#ifndef BUCKWILD_EBPF_VERSION_H
#define BUCKWILD_EBPF_VERSION_H

// eBPF program version information
#define EBPF_VERSION_MAJOR @EBPF_VERSION_MAJOR@
#define EBPF_VERSION_MINOR @EBPF_VERSION_MINOR@
#define EBPF_VERSION_PATCH @EBPF_VERSION_PATCH@
#define EBPF_VERSION_STRING "@EBPF_VERSION@"

// Security feature flags
#define EBPF_SECURITY_FEATURES_ENABLED 1
#define EBPF_FRAGMENT_SECURITY_ENABLED 1
#define EBPF_ANTI_REPLAY_ENABLED 1
#define EBPF_ATTACK_DETECTION_ENABLED 1
#define EBPF_RATE_LIMITING_ENABLED 1

// Compatibility information
#define EBPF_MIN_KERNEL_VERSION_MAJOR 5
#define EBPF_MIN_KERNEL_VERSION_MINOR 4
#define EBPF_BTF_REQUIRED 1
#define EBPF_CO_RE_REQUIRED 1

// Build information
#define EBPF_BUILD_DATE "@CMAKE_BUILD_DATE@"
#define EBPF_BUILD_TYPE "@CMAKE_BUILD_TYPE@"

#endif // BUCKWILD_EBPF_VERSION_H